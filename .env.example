# JVS Configuration Example (copy to .env and fill in your credentials; never commit .env)

# SQLite causal graph database path
JVS_DB_PATH=jvs_causal.db

# LLM Provider: openai | deepseek | doubao | sensenova | ollama | custom
JVS_LLM_PROVIDER=openai
JVS_LLM_BASE_URL=
JVS_LLM_API_KEY=
JVS_LLM_MODEL=
JVS_LLM_MAX_TOKENS=1024
JVS_LLM_TEMPERATURE=0.2
JVS_LLM_TIMEOUT_S=120
JVS_LLM_MAX_RETRIES=4

# Optional Embedding Provider (enables sqlite-vec semantic hybrid retrieval)
JVS_EMBEDDING_MODEL=
JVS_EMBEDDING_BASE_URL=
JVS_EMBEDDING_API_KEY=
JVS_EMBEDDING_DIMENSIONS=1024

# Causal Graph & Retrieval Policies
JVS_CONF_GATE=0.6
JVS_ALLOW_WEAK_EXPAND=false
JVS_ANCHOR_K=5
JVS_MAX_HOPS=3
JVS_REVERSE_ENABLED=true

# Privacy Outbound Gate (fail-closed)
JVS_PRIVACY_ENABLED=true
JVS_PRIVACY_NAMES=
JVS_PRIVACY_REQUIRE_NAMES=false
